// Log parser: parse log lines, extract levels, aggregate counts

let logs = [
    "2024-01-15 08:30:12 [INFO] Application started",
    "2024-01-15 08:30:15 [INFO] Loading configuration",
    "2024-01-15 08:30:16 [WARN] Config file not found, using defaults",
    "2024-01-15 08:31:00 [INFO] Processing 150 records",
    "2024-01-15 08:31:05 [ERROR] Failed to parse record #42",
    "2024-01-15 08:31:10 [WARN] Retrying failed operation",
    "2024-01-15 08:31:15 [INFO] Processing complete",
    "2024-01-15 08:31:20 [INFO] Shutting down"
];

fn extract_level(line) {
    if (line.contains("[INFO]")) { return "INFO"; }
    if (line.contains("[WARN]")) { return "WARN"; }
    if (line.contains("[ERROR]")) { return "ERROR"; }
    if (line.contains("[DEBUG]")) { return "DEBUG"; }
    return "UNKNOWN";
}

fn extract_timestamp(line) {
    return line.substr(0, 19);
}

fn extract_message(line) {
    // Find the "] " after the level tag and get the rest
    let parts = line.split("] ");
    if (parts.length > 1) {
        return parts[1];
    }
    return line;
}

// Count by level
let info_count = 0;
let warn_count = 0;
let error_count = 0;

print("=== Log Analysis ===");
for (line in logs) {
    let level = extract_level(line);
    let ts = extract_timestamp(line);
    let msg = extract_message(line);

    if (level == "INFO") { info_count++; }
    if (level == "WARN") { warn_count++; }
    if (level == "ERROR") { error_count++; }
}

print(`Total lines: ${logs.length}`);
print(`INFO: ${info_count}`);
print(`WARN: ${warn_count}`);
print(`ERROR: ${error_count}`);

// Find errors
print("\n=== Error Details ===");
for (line in logs) {
    if (line.contains("[ERROR]")) {
        print(`  ${extract_timestamp(line)}: ${extract_message(line)}`);
    }
}
