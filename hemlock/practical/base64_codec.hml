// Base64 encoder/decoder from scratch (no stdlib)

let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn b64_encode(input) {
    let bytes = input.to_bytes();
    let result = "";
    let i = 0;
    let len = bytes.length;

    while (i < len) {
        let b0 = bytes[i];
        let b1 = 0;
        let b2 = 0;
        let pad = 0;

        if (i + 1 < len) {
            b1 = bytes[i + 1];
        } else {
            pad = 2;
        }

        if (i + 2 < len) {
            b2 = bytes[i + 2];
        } else if (pad == 0) {
            pad = 1;
        }

        let idx0 = (b0 >> 2) & 63;
        let idx1 = ((b0 & 3) << 4) | ((b1 >> 4) & 15);
        let idx2 = ((b1 & 15) << 2) | ((b2 >> 6) & 3);
        let idx3 = b2 & 63;

        result = result + chars.char_at(idx0);
        result = result + chars.char_at(idx1);

        if (pad == 2) {
            result = result + "==";
        } else if (pad == 1) {
            result = result + chars.char_at(idx2);
            result = result + "=";
        } else {
            result = result + chars.char_at(idx2);
            result = result + chars.char_at(idx3);
        }

        i = i + 3;
    }

    return result;
}

fn b64_char_index(c) {
    for (let i = 0; i < 64; i++) {
        if (chars.char_at(i) == c) {
            return i;
        }
    }
    return -1;
}

fn b64_decode(input) {
    let result = [];
    let i = 0;
    let len = input.length;

    while (i < len) {
        let c0 = b64_char_index(input.char_at(i));
        let c1 = b64_char_index(input.char_at(i + 1));
        let c2 = -1;
        let c3 = -1;

        if (input.char_at(i + 2) != "=") {
            c2 = b64_char_index(input.char_at(i + 2));
        }
        if (input.char_at(i + 3) != "=") {
            c3 = b64_char_index(input.char_at(i + 3));
        }

        let byte0 = ((c0 << 2) | ((c1 >> 4) & 3)) & 255;
        result.push(byte0);

        if (c2 >= 0) {
            let byte1 = (((c1 & 15) << 4) | ((c2 >> 2) & 15)) & 255;
            result.push(byte1);
        }

        if (c3 >= 0) {
            let byte2 = (((c2 & 3) << 6) | c3) & 255;
            result.push(byte2);
        }

        i = i + 4;
    }

    // Convert bytes back to string
    let str = "";
    for (b in result) {
        let r = rune(b);
        str = str + `${r}`;
    }
    return str;
}

let original = "Hello, World!";
let encoded = b64_encode(original);
print(`original: ${original}`);
print(`encoded:  ${encoded}`);

// Also verify with known value
let expected = "SGVsbG8sIFdvcmxkIQ==";
if (encoded == expected) {
    print("encoding: correct");
} else {
    print(`encoding: mismatch (expected ${expected})`);
}

// Decode back - use byte-level approach
let decoded_bytes = [];
let i = 0;
let enc_len = encoded.length;
while (i < enc_len) {
    let c0 = b64_char_index(encoded.char_at(i));
    let c1 = b64_char_index(encoded.char_at(i + 1));
    let c2 = -1;
    let c3 = -1;
    if (encoded.char_at(i + 2) != "=") { c2 = b64_char_index(encoded.char_at(i + 2)); }
    if (encoded.char_at(i + 3) != "=") { c3 = b64_char_index(encoded.char_at(i + 3)); }

    decoded_bytes.push(((c0 << 2) | ((c1 >> 4) & 3)) & 255);
    if (c2 >= 0) { decoded_bytes.push((((c1 & 15) << 4) | ((c2 >> 2) & 15)) & 255); }
    if (c3 >= 0) { decoded_bytes.push((((c2 & 3) << 6) | c3) & 255); }
    i = i + 4;
}

// Reconstruct string from byte values
let decoded = "";
for (b in decoded_bytes) {
    // Use rune conversion from byte value
    let r = rune(b);
    decoded = decoded + `${r}`;
}

print(`decoded:  ${decoded}`);

if (decoded == original) {
    print("round-trip: ok");
} else {
    print("round-trip: FAILED");
}
