// Dynamic array that grows using realloc pattern (alloc new, copy, free old)
import { divi } from "@stdlib/math";

let capacity = 4;
let size = 0;
let data = alloc(capacity * 4); // i32 = 4 bytes

fn grow() {
    let new_cap = capacity * 2;
    let new_data = alloc(new_cap * 4);
    memcpy(new_data, data, size * 4);
    free(data);
    data = new_data;
    capacity = new_cap;
}

fn push(val: i32) {
    if (size == capacity) {
        grow();
    }
    let slot = ptr_offset(data, size, 4);
    ptr_write_i32(slot, val);
    size++;
}

fn print_all() {
    write("values:");
    for (let i = 0; i < size; i++) {
        let slot = ptr_offset(data, i, 4);
        let val = ptr_deref_i32(slot);
        write(` ${val}`);
    }
    print("");
}

for (let i = 1; i <= 10; i++) {
    push(i);
}

print(`capacity: ${capacity}`);
print_all();
free(data);
