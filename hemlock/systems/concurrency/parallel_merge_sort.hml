// Parallel Merge Sort
// Split array, sort halves in parallel tasks, then merge.

fn merge(left, right) {
    let result = [];
    let i = 0;
    let j = 0;
    while (i < left.length && j < right.length) {
        if (left[i] <= right[j]) {
            result.push(left[i]);
            i++;
        } else {
            result.push(right[j]);
            j++;
        }
    }
    while (i < left.length) {
        result.push(left[i]);
        i++;
    }
    while (j < right.length) {
        result.push(right[j]);
        j++;
    }
    return result;
}

async fn merge_sort(arr) {
    if (arr.length <= 1) {
        return arr;
    }

    let mid = arr.length / 2;
    // Truncate to integer
    mid = i32(mid);

    let left = arr.slice(0, mid);
    let right = arr.slice(mid, arr.length);

    // Sort halves in parallel
    let left_task = spawn(merge_sort, left);
    let right_task = spawn(merge_sort, right);

    let sorted_left = join(left_task);
    let sorted_right = join(right_task);

    return merge(sorted_left, sorted_right);
}

let arr = [38, 27, 43, 3, 9, 82, 10, 55];
let task = spawn(merge_sort, arr);
let sorted = join(task);

print(`sorted: ${sorted.join(" ")}`);
