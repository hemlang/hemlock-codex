// In Hemlock, goroutines become spawn(), channels work similarly,
// and sync.WaitGroup is replaced by join() on task handles.

let jobs = channel(12);
let results = channel(12);

async fn worker(jobs, results) {
    loop {
        let j = jobs.recv();
        if (j == null) {
            break;
        }
        results.send(j * j);
    }
}

// Send all jobs
for (let i = 1; i <= 12; i++) {
    jobs.send(i);
}
jobs.close();

// Spawn 4 workers (fan-out)
let tasks = [];
for (let w = 0; w < 4; w++) {
    tasks.push(spawn(worker, jobs, results));
}

// Wait for all workers (replaces wg.Wait())
for (let i = 0; i < 4; i++) {
    join(tasks[i]);
}
results.close();

// Collect results (fan-in)
let collected = [];
loop {
    let r = results.recv();
    if (r == null) {
        break;
    }
    collected.push(r);
}

collected.sort();
print(collected.join(" "));
