import { parse } from "@stdlib/csv";

let data = "name,age,score\nAlice,30,85\nBob,25,92\nCharlie,35,78\nDiana,28,95\nEve,32,88";

let rows = parse(data);

// Filter high scorers (score >= 85)
// parse() returns arrays of strings; rows[0] is header
let header = rows[0];
let data_rows = rows.slice(1);

let high_scorers = data_rows.filter(fn(row) {
    return i32(row[2]) >= 85;
});

print(`High scorers (>=85): ${high_scorers.length}`);
for (row in high_scorers) {
    print(`  ${row[0]}: ${row[2]}`);
}

// Compute average score of high scorers
let total = high_scorers.reduce(fn(sum, row) {
    return sum + i32(row[2]);
}, 0);
let avg = total / high_scorers.length;
print(`Average score: ${avg}`);
