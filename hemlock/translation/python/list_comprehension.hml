// Python equivalent:
// squares = [x*x for x in range(1, 11) if x % 2 == 0]
// print(" ".join(str(s) for s in squares))
// Output: 4 16 36 64 100

// In Hemlock, list comprehensions become .filter().map() chains.

// Build range 1..10
let nums = [];
for (let i = 1; i <= 10; i++) {
    nums.push(i);
}

// Filter even, then square
let squares = nums
    .filter(fn(x) { return x % 2 == 0; })
    .map(fn(x) { return x * x; });

print(squares.join(" "));
