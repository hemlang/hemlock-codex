// In Hemlock, the socket/bind/listen/accept pattern is replaced by
// channels for inter-task communication. This demonstrates the
// producer/consumer echo pattern that replaces raw TCP sockets.
//
// For real TCP, Hemlock has @stdlib/net with TcpListener/TcpStream,
// but that would block in a test. Channels show the same pattern.

// Simulate a TCP echo server using channels (producer/consumer pattern)
async fn echo_server(request_ch, response_ch) {
    // Server loop: read request, echo it back
    let msg = request_ch.recv();
    while (msg != null) {
        // Echo: send back the same message
        response_ch.send(`echo: ${msg}`);
        msg = request_ch.recv();
    }
}

async fn client(request_ch, response_ch) {
    // Send messages to server
    let messages = ["hello", "world", "goodbye"];
    for (msg in messages) {
        request_ch.send(msg);
        let reply = response_ch.recv();
        print(reply);
    }
    // Signal done
    request_ch.send(null);
}

// Create channels (like socket pairs)
let request_ch = channel(1);
let response_ch = channel(1);

// Spawn server and client tasks
let server_task = spawn(echo_server, request_ch, response_ch);
let client_task = spawn(client, request_ch, response_ch);

join(client_task);
join(server_task);

print("server pattern demonstrated");
