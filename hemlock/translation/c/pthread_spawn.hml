// In Hemlock, pthreads become spawn/join.
// No need for void* casting, mutex setup, or thread attribute structs.
// Each spawned task returns a value directly.

import { divi } from "@stdlib/math";

async fn worker(start, end) {
    let sum = 0;
    for (let i = start; i <= end; i++) {
        sum = sum + i;
    }
    return sum;
}

let num_threads = 4;
let chunk = divi(100, num_threads);

let tasks = [];
for (let i = 0; i < num_threads; i++) {
    let start = i * chunk + 1;
    let end = chunk;
    if (i == num_threads - 1) {
        end = 100;
    } else {
        end = (i + 1) * chunk;
    }
    let t = spawn(worker, start, end);
    tasks.push(t);
}

let total = 0;
for (t in tasks) {
    let result = join(t);
    total = total + result;
}

print(`total: ${total}`);
