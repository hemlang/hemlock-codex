// In Hemlock, C structs become `define` types.
// Functions take objects explicitly (no methods).

import { sqrt } from "@stdlib/math";

define Point {
    x: f64,
    y: f64
}

define Vector2D {
    x: f64,
    y: f64
}

fn point_add(a, b) {
    let result: Point = { x: a.x + b.x, y: a.y + b.y };
    return result;
}

fn vec_scale(v, s) {
    let result: Vector2D = { x: v.x * s, y: v.y * s };
    return result;
}

fn vec_magnitude(v) {
    return sqrt(v.x * v.x + v.y * v.y);
}

let a: Point = { x: 1.0, y: 2.0 };
let b: Point = { x: 3.0, y: 4.0 };
let c = point_add(a, b);
print(`add: (${c.x}, ${c.y})`);

let v: Vector2D = { x: 3.0, y: 4.0 };
let scaled = vec_scale(v, 2.0);
print(`scale: (${scaled.x}, ${scaled.y})`);
print(`magnitude: ${vec_magnitude(v)}`);
