// In Hemlock, fork/exec/wait maps to spawn/join.
// spawn() creates a lightweight task (like a child process).
// join() waits for it to complete (like waitpid).

async fn do_work(id) {
    print(`child ${id}: computing`);
    let sum = 0;
    for (let i = 0; i < 1000; i++) {
        sum = sum + i;
    }
    print(`child ${id}: result = ${sum}`);
    return sum;
}

print("parent: spawning children");

let tasks = [];
for (let i = 0; i < 3; i++) {
    let t = spawn(do_work, i);
    tasks.push(t);
}

// Wait for all children (like calling wait() in a loop)
for (t in tasks) {
    join(t);
}

print("parent: all children done");
