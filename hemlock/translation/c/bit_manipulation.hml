// In Hemlock, bitwise operators are identical to C: &, |, ^, ~, <<, >>
// The main difference is no pass-by-pointer — functions return new values.

fn set_bit(n, pos) {
    return n | (1 << pos);
}

fn clear_bit(n, pos) {
    return n & ~(1 << pos);
}

fn toggle_bit(n, pos) {
    return n ^ (1 << pos);
}

fn check_bit(n, pos) {
    return (n >> pos) & 1;
}

fn count_bits(n) {
    let count = 0;
    let val = n;
    while (val != 0) {
        count = count + (val & 1);
        val = val >> 1;
    }
    return count;
}

let flags = 0;
flags = set_bit(flags, 0);   // bit 0
flags = set_bit(flags, 3);   // bit 3
flags = set_bit(flags, 7);   // bit 7
print(`after set: ${flags}`);

print(`bit 3: ${check_bit(flags, 3)}`);
print(`bit 2: ${check_bit(flags, 2)}`);

flags = clear_bit(flags, 0);
print(`after clear bit 0: ${flags}`);

flags = toggle_bit(flags, 3);
print(`after toggle bit 3: ${flags}`);

print(`popcount: ${count_bits(flags)}`);

print(`left shift: ${1 << 10}`);
print(`right shift: ${256 >> 3}`);
