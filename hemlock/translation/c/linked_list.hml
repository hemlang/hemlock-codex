// In Hemlock, C linked list nodes become objects with value + next fields.
// No typedef needed — objects are structural.

fn push(head, value) {
    let node = { value: value, next: head };
    return node;
}

fn print_list(head) {
    write("list:");
    let cur = head;
    while (cur != null) {
        write(` ${cur.value}`);
        cur = cur.next;
    }
    print("");
}

// Build list: push 5,4,3,2,1 so traversal order is 1,2,3,4,5
let list = null;
for (let i = 5; i >= 1; i--) {
    list = push(list, i);
}

print_list(list);
