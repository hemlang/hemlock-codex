// In Hemlock, strings are first-class with built-in methods.
// No need for <string.h> — methods are on the string value itself.

let s = "Hello, World!";

// strlen → .length
print(`length: ${s.length}`);

// strcat → string concatenation with +
let greeting = "Hello," + " " + "World!";
print(`concat: ${greeting}`);

// strcmp → direct comparison with == and <
let a = "abc";
let b = "abc";
let c = "def";
print(`equal: ${a == b}`);
print(`less: ${a < c}`);

// strstr → .find() returns index or -1
let idx = s.find("World");
print(`found at: ${idx}`);

// No C equivalent — Hemlock has built-in replace
let replaced = s.replace("World", "Hemlock");
print(`replaced: ${replaced}`);

// More string methods that are painful in C
print(`upper: ${s.to_upper()}`);
print(`starts_with: ${s.starts_with("Hello")}`);
print(`contains: ${s.contains("World")}`);

let csv = "one,two,three";
let parts = csv.split(",");
print(`split: ${parts.join(" | ")}`);
