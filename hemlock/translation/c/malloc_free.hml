// In Hemlock, malloc/free become alloc/free.
// Array element access uses ptr_offset + ptr_write/ptr_deref
// with an explicit stride (4 bytes for i32).

let n = 10;
let arr = alloc(n * 4); // 10 * sizeof(i32)

// Fill with squares
for (let i = 0; i < n; i++) {
    let p = ptr_offset(arr, i, 4);
    ptr_write_i32(p, i * i);
}

// Print all values on one line
for (let i = 0; i < n; i++) {
    let p = ptr_offset(arr, i, 4);
    let val = ptr_deref_i32(p);
    if (i > 0) {
        write(" ");
    }
    write(`${val}`);
}
print("");

// Manual cleanup, just like C
free(arr);
