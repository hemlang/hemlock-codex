// In Hemlock, try/catch/finally has identical syntax to JavaScript.
// throw takes any value (not just Error objects).

fn risky_operation(value) {
    try {
        print("try: starting");
        if (value < 0) {
            throw "negative value";
        }
        if (value == 0) {
            throw "zero value";
        }
        print(`try: success with ${value}`);
    } catch (e) {
        print(`catch: ${e}`);
    } finally {
        print("finally: cleanup");
    }
}

risky_operation(42);
print("---");
risky_operation(-1);
print("---");
risky_operation(0);
