// In Hemlock, Map/Set aren't built-in literals.
// Import HashMap and Set from @stdlib/collections.

import { HashMap, Set } from "@stdlib/collections";

// HashMap — equivalent to JavaScript's Map
let map = HashMap();
map.set("name", "hemlock");
map.set("version", "2.0");
map.set("type", "language");

print(`has name: ${map.has("name")}`);
print(`name: ${map.get("name")}`);

map.delete("type");
print(`has type: ${map.has("type")}`);

let keys = map.keys();
keys.sort(fn(a, b) { if (a < b) { return -1; } if (a > b) { return 1; } return 0; });
print(`keys: ${keys.join(", ")}`);

// Set — equivalent to JavaScript's Set
let s = Set();
s.add("apple");
s.add("banana");
s.add("apple");  // duplicate ignored

print(`set size: ${s.size}`);
print(`has apple: ${s.has("apple")}`);

let vals = s.values();
vals.sort(fn(a, b) { if (a < b) { return -1; } if (a > b) { return 1; } return 0; });
print(`values: ${vals.join(", ")}`);
