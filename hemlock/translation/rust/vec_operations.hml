// In Hemlock, Vec becomes a dynamic array with built-in methods.
// No ownership/borrowing — arrays are mutable by default.

let nums = [];
nums.push(5);
nums.push(3);
nums.push(8);
nums.push(1);
nums.push(4);
print(`after push: ${nums}`);

let popped = nums.pop();
print(`popped: ${popped}`);
print(`after pop: ${nums}`);

let doubled = nums.map(fn(x) { return x * 2; });
print(`doubled: ${doubled}`);

let evens = nums.filter(fn(x) { return x % 2 == 0; });
print(`evens: ${evens}`);

let sorted = nums.slice(0, nums.length);
sorted.sort(fn(a, b) { return a - b; });
print(`sorted: ${sorted}`);

print(`contains 3: ${nums.contains(3)}`);
print(`contains 9: ${nums.contains(9)}`);
print(`len: ${nums.length}`);
