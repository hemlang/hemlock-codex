// In Hemlock, Option<T> becomes nullable return (null = None).
// Result<T, E> becomes try/catch with throw for errors.

fn find_user(id) {
    if (id == 1) { return "Alice"; }
    if (id == 2) { return "Bob"; }
    return null;
}

fn parse_port(s) {
    let n = null;
    try {
        n = i32(s);
    } catch (e) {
        throw `invalid number: ${s}`;
    }
    if (n < 1 || n > 65535) {
        throw `port out of range: ${n}`;
    }
    return n;
}

// Option: null check replaces match on Some/None
let user1 = find_user(1);
if (user1 != null) {
    print(`found: ${user1}`);
} else {
    print("not found");
}

let user99 = find_user(99);
if (user99 != null) {
    print(`found: ${user99}`);
} else {
    print("not found");
}

// Result: try/catch replaces match on Ok/Err
try {
    let p = parse_port("8080");
    print(`port: ${p}`);
} catch (e) {
    print(`error: ${e}`);
}

try {
    let p = parse_port("abc");
    print(`port: ${p}`);
} catch (e) {
    print(`error: ${e}`);
}

try {
    let p = parse_port("99999");
    print(`port: ${p}`);
} catch (e) {
    print(`error: ${e}`);
}
