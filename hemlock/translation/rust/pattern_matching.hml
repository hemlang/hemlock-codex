// In Hemlock, match works similarly to Rust: value matching, OR patterns,
// guards, and variable binding are all supported.

// Value matching with OR patterns and guards
fn classify(n) {
    return match (n) {
        0 => "zero",
        1 | 2 | 3 => "small",
        x if x < 0 => "negative",
        x if x < 10 => "medium",
        x if x < 100 => "large",
        x => "huge"
    };
}

// Test classify
let test_vals = [-5, 0, 2, 7, 42, 999];
for (val in test_vals) {
    print(`${val}: ${classify(val)}`);
}

// Variable binding in match
fn describe_value(x) {
    return match (x) {
        0 => "nothing",
        v if v > 0 && v <= 10 => `small positive: ${v}`,
        v if v > 10 => `big positive: ${v}`,
        v => `negative: ${v}`
    };
}

print(`${describe_value(0)}`);
print(`${describe_value(5)}`);
print(`${describe_value(50)}`);
print(`${describe_value(-3)}`);

// Match on strings
fn greet(lang) {
    return match (lang) {
        "en" | "english" => "Hello!",
        "es" | "spanish" => "Hola!",
        "fr" | "french" => "Bonjour!",
        other => `Unknown language: ${other}`
    };
}

print(greet("en"));
print(greet("spanish"));
print(greet("fr"));
print(greet("de"));

// Match as expression in variable assignment
let score = 85;
let grade = match (score) {
    v if v >= 90 => "A",
    v if v >= 80 => "B",
    v if v >= 70 => "C",
    v if v >= 60 => "D",
    v => "F"
};
print(`score ${score}: grade ${grade}`);
