fn counting_sort(arr) {
    let n = arr.length;
    if (n == 0) { return arr; }

    let max_val = arr[0];
    for (let i = 1; i < n; i++) {
        if (arr[i] > max_val) {
            max_val = arr[i];
        }
    }

    let count = [];
    for (let i = 0; i <= max_val; i++) {
        count.push(0);
    }

    for (let i = 0; i < n; i++) {
        count[arr[i]] = count[arr[i]] + 1;
    }

    let idx = 0;
    for (let i = 0; i <= max_val; i++) {
        while (count[i] > 0) {
            arr[idx] = i;
            idx++;
            count[i] = count[i] - 1;
        }
    }
    return arr;
}

let arr = [64, 34, 25, 12, 22, 11, 90, 1, 45, 78];
counting_sort(arr);
print(arr.join(" "));
