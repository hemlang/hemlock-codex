fn make_queue() {
    return { inbox: [], outbox: [] };
}

fn enqueue(q, val) {
    q.inbox.push(val);
}

fn dequeue(q) {
    if (q.outbox.length == 0) {
        while (q.inbox.length > 0) {
            q.outbox.push(q.inbox.pop());
        }
    }
    return q.outbox.pop();
}

let q = make_queue();
enqueue(q, 1);
enqueue(q, 2);
enqueue(q, 3);

let results = [];
results.push(dequeue(q));
results.push(dequeue(q));

enqueue(q, 4);
enqueue(q, 5);

results.push(dequeue(q));
results.push(dequeue(q));
results.push(dequeue(q));

print(results.join(" "));
