// Coin Change Problem (Minimum Coins)
// Dynamic programming approach to find the minimum number of coins
// needed to make a given amount.

fn coin_change(coins, amount) {
    // dp[i] = minimum coins needed to make amount i
    // Use amount + 1 as "infinity" (impossible)
    let dp = [];
    for (let i = 0; i <= amount; i++) {
        dp.push(amount + 1);
    }
    dp[0] = 0;

    for (let i = 1; i <= amount; i++) {
        for (let j = 0; j < coins.length; j++) {
            if (coins[j] <= i) {
                let candidate = dp[i - coins[j]] + 1;
                if (candidate < dp[i]) {
                    dp[i] = candidate;
                }
            }
        }
    }

    if (dp[amount] > amount) {
        return -1;
    }
    return dp[amount];
}

let coins = [1, 5, 10, 25];
let amount = 36;
let result = coin_change(coins, amount);
print(`min coins: ${result}`);
