// Longest Common Subsequence (LCS)
// Dynamic programming approach to find the longest subsequence
// common to two strings.

import { max } from "@stdlib/math";

fn lcs(a, b) {
    let m = a.length;
    let n = b.length;

    // Build DP table
    let dp = [];
    for (let i = 0; i <= m; i++) {
        let row = [];
        for (let j = 0; j <= n; j++) {
            row.push(0);
        }
        dp.push(row);
    }

    for (let i = 1; i <= m; i++) {
        for (let j = 1; j <= n; j++) {
            if (a.char_at(i - 1) == b.char_at(j - 1)) {
                dp[i][j] = dp[i - 1][j - 1] + 1;
            } else {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }
    }

    // Backtrack to find the actual subsequence
    let result = "";
    let i = m;
    let j = n;
    while (i > 0 && j > 0) {
        if (a.char_at(i - 1) == b.char_at(j - 1)) {
            result = a.char_at(i - 1) + result;
            i--;
            j--;
        } else if (dp[i - 1][j] >= dp[i][j - 1]) {
            i--;
        } else {
            j--;
        }
    }

    return { length: dp[m][n], subsequence: result };
}

let a = "ABCBDAB";
let b = "BDCAB";
let result = lcs(a, b);
print(`lcs length: ${result.length}`);
print(`lcs: ${result.subsequence}`);
