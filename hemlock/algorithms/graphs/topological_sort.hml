// Topological Sort (Kahn's Algorithm)
// Finds a linear ordering of vertices in a DAG such that for every edge u->v,
// u comes before v in the ordering.

fn topological_sort(adj, n) {
    // Compute in-degrees
    let in_degree = [];
    for (let i = 0; i < n; i++) {
        in_degree.push(0);
    }
    for (let u = 0; u < n; u++) {
        for (v in adj[u]) {
            in_degree[v] = in_degree[v] + 1;
        }
    }

    // Enqueue nodes with in-degree 0
    let queue = [];
    for (let i = 0; i < n; i++) {
        if (in_degree[i] == 0) {
            queue.push(i);
        }
    }

    let order = [];
    while (queue.length > 0) {
        let u = queue.shift();
        order.push(u);
        for (v in adj[u]) {
            in_degree[v] = in_degree[v] - 1;
            if (in_degree[v] == 0) {
                queue.push(v);
            }
        }
    }

    return order;
}

// DAG: 5->[0,2], 4->[0,1], 2->[3], 3->[1]
let n = 6;
let adj = [[], [], [3], [1], [0, 1], [0, 2]];

let result = topological_sort(adj, n);
print(`topological order: ${result.join(" ")}`);
