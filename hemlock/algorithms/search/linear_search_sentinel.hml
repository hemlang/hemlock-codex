// Linear Search with Sentinel
// Uses a sentinel value appended to the end of the array to eliminate
// the bounds check inside the loop, improving performance.

fn linear_search_sentinel(arr, target) {
    let n = arr.length;

    // Save last element and place sentinel
    let last = arr[n - 1];
    arr[n - 1] = target;

    let i = 0;
    while (arr[i] != target) {
        i++;
    }

    // Restore the last element
    arr[n - 1] = last;

    // Check if we found the target or just hit the sentinel
    if (i < n - 1) {
        return i;
    }
    if (arr[n - 1] == target) {
        return n - 1;
    }
    return null;
}

let arr = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91];

let result1 = linear_search_sentinel(arr, 23);
if (result1 != null) {
    print(`search 23: found at index ${result1}`);
} else {
    print("search 23: not found");
}

let result2 = linear_search_sentinel(arr, 50);
if (result2 != null) {
    print(`search 50: found at index ${result2}`);
} else {
    print("search 50: not found");
}
